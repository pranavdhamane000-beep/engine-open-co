{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "anim/command_envelope_v1",
  "title": "Command envelope (schema v1)",
  "description": "The single mutation-boundary submission shape (DES spec 12.8/12.10): identical for editor, CLI and future automation. Tagged per-command payloads are dispatched by anim_commands::registry.",
  "type": "object",
  "required": ["schema_version", "project_id", "command_id", "expected_scene_revision", "transaction_label", "commands"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": 1 },
    "project_id": { "type": "string", "format": "uuid" },
    "command_id": { "type": "string", "format": "uuid" },
    "expected_scene_revision": { "type": "integer", "minimum": 0 },
    "transaction_label": { "type": "string" },
    "commands": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/command" } }
  },
  "definitions": {
    "command": {
      "type": "object",
      "required": ["type"],
      "properties": { "type": { "type": "string" } },
      "oneOf": [
        { "properties": { "type": { "const": "upsert_asset" }, "entry": { "$ref": "anim/project_v1#/definitions/assetManifestEntry" } }, "additionalProperties": false },
        { "properties": { "type": { "const": "replace_asset" }, "entry": { "$ref": "anim/project_v1#/definitions/assetManifestEntry" } }, "additionalProperties": false },
        { "properties": { "type": { "const": "remove_asset" }, "asset_id": { "type": "string", "format": "uuid" } }, "additionalProperties": false },
        { "properties": { "type": { "const": "upsert_scene" }, "scene_id": { "type": "string", "format": "uuid" }, "name": { "type": "string" } }, "additionalProperties": false },
        { "properties": { "type": { "const": "rename_scene" }, "scene_id": { "type": "string", "format": "uuid" }, "name": { "type": "string" } }, "additionalProperties": false },
        { "properties": { "type": { "const": "remove_scene" }, "scene_id": { "type": "string", "format": "uuid" } }, "additionalProperties": false },
        { "properties": { "type": { "const": "upsert_node" }, "scene_id": { "type": "string", "format": "uuid" }, "node_id": { "type": "string", "format": "uuid" }, "name": { "type": "string" }, "parent": { "type": ["string", "null"], "format": "uuid" }, "asset": { "type": ["string", "null"], "format": "uuid" } }, "additionalProperties": false },
        { "properties": { "type": { "const": "remove_node" }, "scene_id": { "type": "string", "format": "uuid" }, "node_id": { "type": "string", "format": "uuid" } }, "additionalProperties": false },
        { "properties": { "type": { "const": "set_node_property" }, "scene_id": { "type": "string", "format": "uuid" }, "node_id": { "type": "string", "format": "uuid" }, "property": { "type": "string", "minLength": 1 }, "key": { "$ref": "anim/project_v1#/definitions/propertyKey" } }, "additionalProperties": false },
        { "properties": { "type": { "const": "remove_node_property_key" }, "scene_id": { "type": "string", "format": "uuid" }, "node_id": { "type": "string", "format": "uuid" }, "property": { "type": "string", "minLength": 1 }, "key_time": { "type": "string", "pattern": "^-?[0-9]+/[1-9][0-9]*$" } }, "additionalProperties": false },
        { "properties": { "type": { "const": "set_frame_rate" }, "num": { "type": "integer", "minimum": 1 }, "den": { "type": "integer", "minimum": 1 } }, "additionalProperties": false }
      ],
      "note": "Restore commands (restore_scene_data / restore_node_data) are INVERSE-ONLY payloads generated inside the engine; they are never accepted through the external registry dispatch."
    }
  }
}
